  "tokenColors": [
    {"scope": ["comment", "punctuation.definition.comment"], "settings": {"foreground": "{{adj.comment}}", "fontStyle": "italic"}},
    {"scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": {"foreground": "{{adj.keyword}}"}},
    {"scope": ["string", "string.quoted", "markup.inline.raw"], "settings": {"foreground": "{{adj.string}}"}},
    {"scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": {"foreground": "{{adj.function}}"}},
    {"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": {"foreground": "{{adj.type}}"}},
    {"scope": ["constant.numeric", "constant.character", "constant.language"], "settings": {"foreground": "{{adj.number}}"}},
    {"scope": ["variable.other.constant", "support.constant", "entity.name.constant"], "settings": {"foreground": "{{adj.constant}}"}},
    {"scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"], "settings": {"foreground": "{{adj.operator}}"}},
    {"scope": ["variable", "variable.other", "meta.definition.variable"], "settings": {"foreground": "{{adj.text}}"}},
    {"scope": ["variable.parameter", "entity.name.tag", "support.type.property-name"], "settings": {"foreground": "{{adj.constant}}"}},
    {"scope": ["punctuation", "meta.brace"], "settings": {"foreground": "{{adj.text_dim}}"}},
    {"scope": ["markup.heading", "entity.name.section"], "settings": {"foreground": "{{adj.function}}", "fontStyle": "bold"}},
    {"scope": ["markup.bold"], "settings": {"fontStyle": "bold"}},
    {"scope": ["markup.italic"], "settings": {"fontStyle": "italic"}},
    {"scope": ["markup.inserted"], "settings": {"foreground": "{{adj.success}}"}},
    {"scope": ["markup.deleted"], "settings": {"foreground": "{{adj.error}}"}},
    {"scope": ["markup.changed"], "settings": {"foreground": "{{adj.info}}"}},
    {"scope": ["invalid"], "settings": {"foreground": "{{adj.error}}"}}
  ]
}
