{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matugen",
  "author": "set-wallpaper",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "{{scheme_mode}}",
      "style": {
        "accents": ["{{adj.accent}}", "{{adj.string}}", "{{adj.keyword}}", "{{adj.number}}"],
        "background.appearance": "opaque",
        "border": "{{adj.ui_outline_variant}}",
        "border.variant": "{{adj.ui_outline_variant}}",
        "border.focused": "{{adj.accent}}",
        "border.selected": "{{adj.accent}}",
        "border.transparent": "{{adj.ui_outline_variant}}40",
        "border.disabled": "{{adj.ui_outline_variant}}60",
        "elevated_surface.background": "{{adj.ui_surface_container_high}}",
        "surface.background": "{{adj.ui_surface_container_low}}",
        "background": "{{adj.ui_surface_container_low}}",
        "element.background": "{{adj.ui_surface_container}}",
        "element.hover": "{{adj.ui_surface_container_high}}",
        "element.active": "{{adj.ui_surface_container_highest}}",
        "element.selected": "{{adj.ui_surface_container_highest}}",
        "element.disabled": "{{adj.ui_surface_container}}",
        "drop_target.background": "{{adj.accent}}30",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{adj.ui_surface_container_high}}",
        "ghost_element.active": "{{adj.ui_surface_container_highest}}",
        "ghost_element.selected": "{{adj.ui_surface_container_highest}}",
        "ghost_element.disabled": "{{adj.ui_surface_container}}",
        "text": "{{adj.text}}",
        "text.muted": "{{adj.text_dim}}",
        "text.placeholder": "{{adj.comment}}",
        "text.disabled": "{{adj.comment}}",
        "text.accent": "{{adj.accent}}",
        "icon": "{{adj.text}}",
        "icon.muted": "{{adj.text_dim}}",
        "icon.disabled": "{{adj.comment}}",
        "icon.placeholder": "{{adj.text_dim}}",
        "icon.accent": "{{adj.accent}}",
        "status_bar.background": "{{adj.ui_surface_container_low}}",
        "title_bar.background": "{{adj.ui_surface_container_low}}",
        "title_bar.inactive_background": "{{adj.ui_surface_container_low}}",
        "toolbar.background": "{{adj.ui_surface}}",
        "tab_bar.background": "{{adj.ui_surface_container_low}}",
        "tab.inactive_background": "{{adj.ui_surface_container_low}}",
        "tab.active_background": "{{adj.ui_surface}}",
        "search.match_background": "{{adj.warning}}50",
        "panel.background": "{{adj.ui_surface_container_low}}",
        "panel.focused_border": "{{adj.accent}}",
        "pane_group.border": "{{adj.ui_outline_variant}}",
        "scrollbar.thumb.background": "{{adj.ui_outline_variant}}80",
        "scrollbar.thumb.hover_background": "{{adj.ui_outline}}80",
        "scrollbar.thumb.border": "{{adj.ui_outline_variant}}",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "{{adj.ui_outline_variant}}",
        "editor.foreground": "{{adj.text}}",
        "editor.background": "{{adj.ui_surface}}",
        "editor.gutter.background": "{{adj.ui_surface}}",
        "editor.subheader.background": "{{adj.ui_surface_container_low}}",
        "editor.active_line.background": "{{adj.ui_surface_container_low}}",
        "editor.highlighted_line.background": "{{adj.ui_surface_container_high}}",
        "editor.line_number": "{{adj.comment}}",
        "editor.active_line_number": "{{adj.text}}",
        "editor.invisible": "{{adj.ui_outline_variant}}",
        "editor.wrap_guide": "{{adj.ui_outline_variant}}40",
        "editor.active_wrap_guide": "{{adj.ui_outline_variant}}80",
        "editor.indent_guide": "{{adj.ui_outline_variant}}",
        "editor.indent_guide_active": "{{adj.comment}}",
        "editor.document_highlight.read_background": "{{adj.accent}}25",
        "editor.document_highlight.write_background": "{{adj.accent}}40",
        "editor.document_highlight.bracket_background": "{{adj.accent}}30",
        "terminal.background": "{{adj.ui_surface}}",
        "terminal.foreground": "{{adj.text}}",
        "terminal.bright_foreground": "{{adj.ansi_bright_white}}",
        "terminal.dim_foreground": "{{adj.text_dim}}",
        "terminal.ansi.background": "{{adj.ui_surface}}",
        "terminal.ansi.black": "{{adj.ansi_black}}",
        "terminal.ansi.bright_black": "{{adj.ansi_bright_black}}",
        "terminal.ansi.dim_black": "{{adj.ansi_black}}",
        "terminal.ansi.red": "{{adj.ansi_red}}",
        "terminal.ansi.bright_red": "{{adj.ansi_bright_red}}",
        "terminal.ansi.dim_red": "{{adj.ansi_red}}",
        "terminal.ansi.green": "{{adj.ansi_green}}",
        "terminal.ansi.bright_green": "{{adj.ansi_bright_green}}",
        "terminal.ansi.dim_green": "{{adj.ansi_green}}",
        "terminal.ansi.yellow": "{{adj.ansi_yellow}}",
        "terminal.ansi.bright_yellow": "{{adj.ansi_bright_yellow}}",
        "terminal.ansi.dim_yellow": "{{adj.ansi_yellow}}",
        "terminal.ansi.blue": "{{adj.ansi_blue}}",
        "terminal.ansi.bright_blue": "{{adj.ansi_bright_blue}}",
        "terminal.ansi.dim_blue": "{{adj.ansi_blue}}",
        "terminal.ansi.magenta": "{{adj.ansi_magenta}}",
        "terminal.ansi.bright_magenta": "{{adj.ansi_bright_magenta}}",
        "terminal.ansi.dim_magenta": "{{adj.ansi_magenta}}",
        "terminal.ansi.cyan": "{{adj.ansi_cyan}}",
        "terminal.ansi.bright_cyan": "{{adj.ansi_bright_cyan}}",
        "terminal.ansi.dim_cyan": "{{adj.ansi_cyan}}",
        "terminal.ansi.white": "{{adj.ansi_white}}",
        "terminal.ansi.bright_white": "{{adj.ansi_bright_white}}",
        "terminal.ansi.dim_white": "{{adj.text_dim}}",
        "link_text.hover": "{{adj.accent}}",
        "conflict": "{{adj.warning}}",
        "conflict.background": "{{adj.warning}}20",
        "conflict.border": "{{adj.warning}}60",
        "created": "{{adj.success}}",
        "created.background": "{{adj.success}}20",
        "created.border": "{{adj.success}}60",
        "deleted": "{{adj.error}}",
        "deleted.background": "{{adj.error}}20",
        "deleted.border": "{{adj.error}}60",
        "modified": "{{adj.info}}",
        "modified.background": "{{adj.info}}20",
        "modified.border": "{{adj.info}}60",
        "renamed": "{{adj.info}}",
        "renamed.background": "{{adj.info}}20",
        "renamed.border": "{{adj.info}}60",
        "error": "{{adj.error}}",
        "error.background": "{{adj.error}}20",
        "error.border": "{{adj.error}}60",
        "warning": "{{adj.warning}}",
        "warning.background": "{{adj.warning}}20",
        "warning.border": "{{adj.warning}}60",
        "info": "{{adj.info}}",
        "info.background": "{{adj.info}}20",
        "info.border": "{{adj.info}}60",
        "success": "{{adj.success}}",
        "success.background": "{{adj.success}}20",
        "success.border": "{{adj.success}}60",
        "hint": "{{adj.success}}",
        "hint.background": "{{adj.success}}20",
        "hint.border": "{{adj.success}}60",
        "predictive": "{{adj.comment}}",
        "predictive.background": "{{adj.comment}}20",
        "predictive.border": "{{adj.comment}}60",
        "hidden": "{{adj.comment}}",
        "hidden.background": "{{adj.comment}}20",
        "hidden.border": "{{adj.comment}}60",
        "ignored": "{{adj.comment}}",
        "ignored.background": "{{adj.comment}}20",
        "ignored.border": "{{adj.comment}}60",
        "unreachable": "{{adj.comment}}",
        "unreachable.background": "{{adj.comment}}20",
        "unreachable.border": "{{adj.comment}}60",
        "players": [
          {"cursor": "{{adj.accent}}", "background": "{{adj.accent}}", "selection": "{{adj.accent}}40"},
          {"cursor": "{{adj.string}}", "background": "{{adj.string}}", "selection": "{{adj.string}}40"},
          {"cursor": "{{adj.keyword}}", "background": "{{adj.keyword}}", "selection": "{{adj.keyword}}40"},
          {"cursor": "{{adj.number}}", "background": "{{adj.number}}", "selection": "{{adj.number}}40"}
        ],
        "syntax": {
          "attribute": {"color": "{{adj.type}}"},
          "boolean": {"color": "{{adj.number}}"},
          "comment": {"color": "{{adj.comment}}", "font_style": "italic"},
          "comment.doc": {"color": "{{adj.comment}}", "font_style": "italic"},
          "constant": {"color": "{{adj.constant}}"},
          "constructor": {"color": "{{adj.type}}"},
          "embedded": {"color": "{{adj.text}}"},
          "emphasis": {"color": "{{adj.accent}}", "font_style": "italic"},
          "emphasis.strong": {"color": "{{adj.accent}}", "font_weight": 700},
          "enum": {"color": "{{adj.type}}"},
          "function": {"color": "{{adj.function}}"},
          "hint": {"color": "{{adj.success}}"},
          "keyword": {"color": "{{adj.keyword}}"},
          "label": {"color": "{{adj.accent}}"},
          "link_text": {"color": "{{adj.info}}"},
          "link_uri": {"color": "{{adj.info}}"},
          "number": {"color": "{{adj.number}}"},
          "operator": {"color": "{{adj.operator}}"},
          "predictive": {"color": "{{adj.comment}}", "font_style": "italic"},
          "preproc": {"color": "{{adj.keyword}}"},
          "primary": {"color": "{{adj.text}}"},
          "property": {"color": "{{adj.constant}}"},
          "punctuation": {"color": "{{adj.text_dim}}"},
          "punctuation.bracket": {"color": "{{adj.text_dim}}"},
          "punctuation.delimiter": {"color": "{{adj.text_dim}}"},
          "punctuation.list_marker": {"color": "{{adj.accent}}"},
          "punctuation.special": {"color": "{{adj.operator}}"},
          "string": {"color": "{{adj.string}}"},
          "string.escape": {"color": "{{adj.number}}"},
          "string.regex": {"color": "{{adj.number}}"},
          "string.special": {"color": "{{adj.number}}"},
          "string.special.symbol": {"color": "{{adj.number}}"},
          "tag": {"color": "{{adj.keyword}}"},
          "text.literal": {"color": "{{adj.string}}"},
          "title": {"color": "{{adj.function}}", "font_weight": 700},
          "type": {"color": "{{adj.type}}"},
          "variable": {"color": "{{adj.text}}"},
          "variable.special": {"color": "{{adj.number}}"},
          "variant": {"color": "{{adj.type}}"}
        }
      }
    }
  ]
}
