// Full-width bar (top of the primary monitor only) and the quick settings panel
// that drops from the island in its middle on click. Colours come from the wallpaper (theme.json, written
// by set-wallpaper); Settings.qml is generated by modules/gui/shell.nix.
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import Quickshell.Wayland

ShellRoot {
    id: root

    readonly property var primaryScreens: {
        const configured = Quickshell.screens.find(screen => screen.name === settings.output);
        if (configured)
            return [configured];

        const external = Quickshell.screens.find(screen => !screen.name.startsWith("eDP-"));
        if (external)
            return [external];

        return Quickshell.screens.length > 0 ? [Quickshell.screens[0]] : [];
    }

    property bool launcherOpen: false
    property bool wallpapersOpen: false
    property bool carouselOpen: false
    property bool clipboardOpen: false
    property bool settingsOpen: false
    property bool recordOpen: false
    property real clipX: 0
    property real clipY: 0
    signal panelToggle

    IpcHandler {
        target: "panel"
        function toggle(): void { root.panelToggle(); }
    }

    IpcHandler {
        target: "wallpapers"
        function toggle(): void { root.wallpapersOpen = !root.wallpapersOpen; }
        function open(): void { root.wallpapersOpen = true; }
        function close(): void { root.wallpapersOpen = false; }
    }

    IpcHandler {
        target: "wallpaperbar"
        function toggle(): void {
            root.launcherOpen = false;
            root.wallpapersOpen = false;
            root.carouselOpen = !root.carouselOpen;
        }
        function open(): void { root.carouselOpen = true; }
        function close(): void { root.carouselOpen = false; }
    }

    IpcHandler {
        target: "settings"
        function toggle(): void { root.settingsOpen = !root.settingsOpen; }
        function open(): void { root.settingsOpen = true; }
        function close(): void { root.settingsOpen = false; }
    }

    IpcHandler {
        target: "record"
        function toggle(): void { root.recordOpen = !root.recordOpen; }
        function open(): void { root.recordOpen = true; }
        function close(): void { root.recordOpen = false; }
    }

    IpcHandler {
        target: "clipboard"
        function toggle(): void {
            if (root.clipboardOpen)
                root.clipboardOpen = false;
            else
                cursorPos.running = true;
        }
        function open(): void { cursorPos.running = true; }
        function close(): void { root.clipboardOpen = false; }
    }

    IpcHandler {
        target: "launcher"
        function toggle(): void { root.launcherOpen = !root.launcherOpen; }
        function open(): void { root.launcherOpen = true; }
        function close(): void { root.launcherOpen = false; }
    }

    // Ask Hyprland where the cursor is, then open the clipboard popup there.
    Process {
        id: cursorPos
        command: ["hyprctl", "cursorpos", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const p = JSON.parse(text);
                    root.clipX = p.x;
                    root.clipY = p.y;
                } catch (e) {}
                root.clipboardOpen = true;
            }
        }
    }

    Settings { id: settings }
    Theme { id: theme; path: settings.themeFile }

    SwitcherController { id: switcher }

    SettingsWindow {
        open: root.settingsOpen
        onCloseRequested: root.settingsOpen = false
        onWallpapersRequested: { root.settingsOpen = false; root.wallpapersOpen = true; }
    }

    Variants {
        model: Quickshell.screens

        WindowSwitcher {
            required property var modelData
            screen: modelData
            ctl: switcher
        }
    }

    Variants {
        model: root.primaryScreens

        WallpaperCarousel {
            required property var modelData
            screen: modelData
            open: root.carouselOpen
            onCloseRequested: root.carouselOpen = false
        }
    }

    Variants {
        model: Quickshell.screens

        RecordMenu {
            required property var modelData
            screen: modelData
            screenName: modelData.name
            open: root.recordOpen
            onCloseRequested: root.recordOpen = false
        }
    }

    // One overlay per screen; only the one under the cursor shows.
    Variants {
        model: Quickshell.screens

        ClipboardPicker {
            required property var modelData
            screen: modelData
            open: root.clipboardOpen
            cursorX: root.clipX
            cursorY: root.clipY
            onCloseRequested: root.clipboardOpen = false
        }
    }

    Variants {
        model: root.primaryScreens

        Scope {
            id: scope
            required property var modelData
            property bool open: false
            property bool mapped: false
            property string menuKind: ""
            property real menuX: 0
            readonly property int flareSize: 24

            onOpenChanged: {
                if (open) {
                    menuKind = "";
                    root.launcherOpen = false;
                    root.wallpapersOpen = false;
                    root.clipboardOpen = false;
                    mapped = true;
                    unmap.stop();
                } else {
                    unmap.restart();
                }
            }
            Connections {
                target: root
                function onPanelToggle() { scope.open = !scope.open; }
                function onLauncherOpenChanged() {
                    if (root.launcherOpen) {
                        scope.open = false;
                        scope.menuKind = "";
                        root.wallpapersOpen = false;
                        root.clipboardOpen = false;
                    }
                }
                function onWallpapersOpenChanged() {
                    if (root.wallpapersOpen) {
                        scope.open = false;
                        scope.menuKind = "";
                        root.launcherOpen = false;
                        root.clipboardOpen = false;
                    }
                }
                function onClipboardOpenChanged() {
                    if (root.clipboardOpen) {
                        scope.open = false;
                        scope.menuKind = "";
                        root.launcherOpen = false;
                        root.wallpapersOpen = false;
                    }
                }
            }
            Timer { id: unmap; interval: 260; onTriggered: scope.mapped = false }

            // One layer surface for both the bar and the panel, so they share a
            // single blur and read as one piece. The window only grows below the
            // bar while the panel is mapped; the mask keeps the empty part of it
            // click-through.
            PanelWindow {
                id: bar
                screen: scope.modelData

                anchors.top: true
                anchors.left: true
                anchors.right: true
                exclusiveZone: settings.height
                // Fixed height (resizing the surface made the bar flicker); the mask
                // below keeps the unused part click-through.
                implicitHeight: settings.height + Math.max(panelClip.height, launcher.maxHeight, wallpapers.maxHeight, statusMenu.maxHeight)
                color: "transparent"
                WlrLayershell.namespace: "pill-bar"
                WlrLayershell.keyboardFocus: (root.launcherOpen || root.wallpapersOpen) ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
                mask: Region {
                    Region { x: 0; y: 0; width: bar.width; height: settings.height }
                    Region {
                        x: panelClip.x - scope.flareSize
                        y: panelClip.y
                        width: panelClip.width + 2 * scope.flareSize
                        height: scope.mapped ? panelClip.height : 0
                    }
                    Region {
                        x: statusMenu.x
                        y: statusMenu.y
                        width: statusMenu.width
                        height: statusMenu.visible ? statusMenu.height : 0
                    }
                    Region {
                        x: launcher.x - scope.flareSize
                        y: launcher.y
                        width: launcher.width + 2 * scope.flareSize
                        height: launcher.visible ? launcher.height : 0
                    }
                    Region {
                        x: wallpapers.x - scope.flareSize
                        y: wallpapers.y
                        width: wallpapers.width + 2 * scope.flareSize
                        height: wallpapers.visible ? wallpapers.height : 0
                    }
                }

                Bar {
                    x: 0
                    y: 0
                    width: parent.width
                    height: settings.height
                    screenName: scope.modelData.name
                    panelOpen: scope.open || root.launcherOpen || root.wallpapersOpen
                    onIslandClicked: { scope.menuKind = ""; scope.open = !scope.open; }
                    onMenuRequested: (kind, x) => {
                        scope.open = false;
                        root.launcherOpen = false;
                        root.wallpapersOpen = false;
                        root.clipboardOpen = false;
                        if (scope.menuKind === kind) {
                            scope.menuKind = "";
                        } else {
                            scope.menuX = x;
                            scope.menuKind = kind;
                        }
                    }
                }

                StatusMenu {
                    id: statusMenu
                    y: settings.height
                    kind: scope.menuKind
                    anchorX: scope.menuX
                    windowWidth: bar.width
                    onCloseRequested: scope.menuKind = ""
                }

                // Concave corners where the panel's sides meet the bar.
                Flare {
                    visible: scope.mapped
                    opacity: Math.max(0, Math.min(1, (panel.y + panel.height) / panel.height))
                    size: scope.flareSize
                    fill: Qt.rgba(theme.surface.r, theme.surface.g, theme.surface.b, theme.opacity * 0.6)
                    x: panelClip.x - size
                    y: settings.height
                }
                Flare {
                    visible: scope.mapped
                    opacity: Math.max(0, Math.min(1, (panel.y + panel.height) / panel.height))
                    rightSide: true
                    size: scope.flareSize
                    fill: Qt.rgba(theme.surface.r, theme.surface.g, theme.surface.b, theme.opacity * 0.6)
                    x: panelClip.x + panelClip.width
                    y: settings.height
                }

                // Slides down out of the bar; the clip edge hides it until it
                // has moved, so it appears to emerge from underneath.
                Item {
                    id: panelClip
                    x: Math.round((parent.width - width) / 2)
                    y: settings.height
                    width: panel.implicitWidth
                    height: panel.implicitHeight
                    clip: true
                    visible: scope.mapped

                    QuickSettings {
                        id: panel
                        width: parent.width
                        height: parent.height
                        y: scope.open ? 0 : -height
                        opacity: scope.open ? 1 : 0
                        Behavior on y { NumberAnimation { duration: 240; easing.type: Easing.OutCubic } }
                        Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
                        onCloseRequested: scope.open = false
                        onWallpapersRequested: root.wallpapersOpen = true
                        onSettingsRequested: root.settingsOpen = true
                        Connections {
                            target: scope
                            function onOpenChanged() { if (scope.open) panel.refresh(); }
                        }
                    }
                }

                Launcher {
                    id: launcher
                    x: Math.round((parent.width - width) / 2)
                    y: settings.height
                    open: root.launcherOpen
                    onCloseRequested: root.launcherOpen = false
                }
                Flare {
                    visible: launcher.visible
                    opacity: launcher.progress
                    size: scope.flareSize
                    fill: Qt.rgba(theme.surface.r, theme.surface.g, theme.surface.b, theme.opacity * 0.6)
                    x: launcher.x - size
                    y: settings.height
                }
                Flare {
                    visible: launcher.visible
                    opacity: launcher.progress
                    rightSide: true
                    size: scope.flareSize
                    fill: Qt.rgba(theme.surface.r, theme.surface.g, theme.surface.b, theme.opacity * 0.6)
                    x: launcher.x + launcher.width
                    y: settings.height
                }

                WallpaperPicker {
                    id: wallpapers
                    x: Math.round((parent.width - width) / 2)
                    y: settings.height
                    open: root.wallpapersOpen
                    onCloseRequested: root.wallpapersOpen = false
                }
                Flare {
                    visible: wallpapers.visible
                    opacity: wallpapers.progress
                    size: scope.flareSize
                    fill: Qt.rgba(theme.surface.r, theme.surface.g, theme.surface.b, theme.opacity * 0.6)
                    x: wallpapers.x - size
                    y: settings.height
                }
                Flare {
                    visible: wallpapers.visible
                    opacity: wallpapers.progress
                    rightSide: true
                    size: scope.flareSize
                    fill: Qt.rgba(theme.surface.r, theme.surface.g, theme.surface.b, theme.opacity * 0.6)
                    x: wallpapers.x + wallpapers.width
                    y: settings.height
                }
            }

            // Click anywhere else to close; the bar is in the grab so clicking
            // it toggles instead of close-then-reopen.
            HyprlandFocusGrab {
                windows: [bar]
                active: scope.open || scope.menuKind !== ""
                onCleared: { scope.open = false; scope.menuKind = ""; }
            }
        }
    }
}
