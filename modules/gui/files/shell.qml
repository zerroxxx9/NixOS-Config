// Standalone file manager. `files [DIR]` (see modules/gui/files.nix) starts one
// window per invocation; closing the window quits. Theme.qml is shared with the
// shell, Settings.qml is generated by Nix.
import QtQuick
import Quickshell

ShellRoot {
    Settings { id: settings }
    Theme { id: theme; path: settings.themeFile }

    FilesWindow {
        start: Quickshell.env("FILES_START") || settings.home
        onClosed: Qt.quit()
    }
}
