// Kinetic Lyrics — synced, expressive lyric typography on the desktop.
// Quickshell port of gnome-kinetic-lyrics by af44n (GPL-3.0).
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Sits on the Wayland background layer: above the wallpaper, below every
// window, and click-through. Settings live in Settings.qml (generated by
// modules/gui/kinetic-lyrics.nix).
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Services.Mpris
import "lyricsClient.js" as Client

ShellRoot {
    id: root

    Settings { id: settings }

    FontLoader { id: capsLoader; source: Qt.resolvedUrl("fonts/LeagueGothic.ttf") }
    FontLoader { id: scriptLoader; source: Qt.resolvedUrl("fonts/NanumBrushScript-Regular.ttf") }

    // Wallpaper palette rendered by set-wallpaper; re-read whenever it changes.
    property var palette: ({})
    readonly property color lyricColor: {
        const c = settings.colorSource ? palette[settings.colorSource] : null;
        return c ? c : settings.color;
    }

    FileView {
        path: settings.colorSource ? settings.colorsFile : ""
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            try {
                root.palette = JSON.parse(text());
            } catch (e) {
                root.palette = {};
            }
        }
    }

    property var player: null
    property string trackKey: ""
    property var lyrics: null        // {provider, lines, wordLevel}
    property int fetchToken: 0
    property real posMs: 0
    property int activeIndex: -1

    // the player that is playing; sticks with the current one until it stops
    function pickPlayer() {
        const all = Mpris.players.values;
        if (player && player.isPlaying && all.indexOf(player) >= 0)
            return player;
        for (const p of all) {
            if (p.isPlaying)
                return p;
        }
        return null;
    }

    function trackOf(p) {
        return {
            title: p.trackTitle ?? "",
            artist: p.trackArtist ?? "",
            album: p.trackAlbum ?? "",
            duration: p.lengthSupported ? p.length : 0
        };
    }

    function onTrackChanged(p) {
        const t = trackOf(p);
        const key = [t.title, t.artist, t.album].join("|");
        if (key === trackKey)
            return;
        trackKey = key;
        lyrics = null;
        activeIndex = -1;
        if (!t.title && !t.artist)
            return;
        const token = ++fetchToken;
        Client.getLyrics(t.title, t.artist, t.album, t.duration, settings.providers, res => {
            if (token !== fetchToken)
                return;
            lyrics = res;
            activeIndex = -1;
        });
    }

    Timer {
        interval: settings.tickMs
        running: true
        repeat: true
        onTriggered: {
            const p = root.pickPlayer();
            root.player = p;
            if (!p) {
                root.activeIndex = -1;
                return;
            }
            root.onTrackChanged(p);
            if (!root.lyrics)
                return;

            p.positionChanged();   // position is polled, not signalled
            let pos = p.position * 1000 + settings.offsetMs;
            // players report position unevenly: ignore small backward steps,
            // honour real seeks
            if (pos < root.posMs && root.posMs - pos < 1500)
                pos = root.posMs;
            root.posMs = pos;

            const lines = root.lyrics.lines;
            let idx = -1;
            for (let i = 0; i < lines.length; i++) {
                if (lines[i].time <= pos)
                    idx = i;
                else
                    break;
            }
            if (idx !== root.activeIndex)
                root.activeIndex = idx;
        }
    }

    Variants {
        model: Quickshell.screens.filter(s => settings.output === "" || s.name === settings.output)

        PanelWindow {
            id: win
            required property var modelData
            screen: modelData

            WlrLayershell.layer: WlrLayer.Background
            WlrLayershell.namespace: "kinetic-lyrics"
            exclusionMode: ExclusionMode.Ignore
            anchors { top: true; bottom: true; left: true; right: true }
            color: "transparent"
            mask: Region {}   // empty input region: clicks fall through

            readonly property bool active: root.lyrics !== null && root.player !== null
            readonly property real columnWidth: Math.min(settings.maxWidth, Math.round(width * settings.columnWidth / 100))

            Item {
                id: column
                width: win.columnWidth
                height: parent.height
                x: settings.position === "left" ? settings.horizontalMargin
                    : settings.position === "center" ? Math.round((win.width - width) / 2)
                    : win.width - width - settings.horizontalMargin
                opacity: win.active ? 1 : 0
                Behavior on opacity { NumberAnimation { duration: settings.lineFadeMs; easing.type: Easing.OutQuad } }

                // the model is a fresh array whenever the line changes, so the
                // delegate is recreated and a new set of words pops in
                Repeater {
                    model: root.lyrics !== null && root.activeIndex >= 0 ? [root.activeIndex] : []
                    delegate: LyricLine {
                        required property int modelData
                        lineData: root.lyrics.lines[modelData]
                        nextTime: root.lyrics.lines[modelData + 1]?.time ?? lineData.time + 5000
                        posMs: root.posMs
                        textColor: root.lyricColor
                        cfg: settings
                        capsFamily: settings.capsFont || capsLoader.name
                        scriptFamily: settings.scriptFont || scriptLoader.name
                        maxW: win.columnWidth
                        y: Math.round((column.height - height) / 2 + settings.verticalOffset)
                    }
                }
            }
        }
    }
}
